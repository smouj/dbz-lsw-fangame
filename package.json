{
 "name": "dbz-lsw-fangame",
 "private": true,
 "version": "0.1.0",
 "type": "module",
 "scripts": {
  "dev": "vite --host 0.0.0.0 --port 5178",
  "build": "vite build",
  "typecheck": "tsc --noEmit",
  "verify:profiles": "esbuild --bundle --format=esm --platform=node scripts/verify-action-profiles.ts --outfile=.verify.mjs && node .verify.mjs; rm -f .verify.mjs",
  "verify:sequences": "esbuild --bundle --format=esm --platform=node scripts/audit-sequences.ts --outfile=.audit-seq.mjs && node .audit-seq.mjs; rm -f .audit-seq.mjs",
  "audit:sprites": "esbuild --bundle --format=esm --platform=node scripts/audit-combat-sprites.ts --outfile=.audit-sprites.mjs && node .audit-sprites.mjs; rm -f .audit-sprites.mjs",
  "verify:gbc": "esbuild --bundle --format=esm --platform=node scripts/verify-gbc-canon.ts --outfile=.gbc-canon.mjs && node .gbc-canon.mjs; rm -f .gbc-canon.mjs",
  "verify:v8": "esbuild --bundle --format=esm --platform=node scripts/verify-v8-catalog.ts --outfile=.v8-catalog.mjs && node .v8-catalog.mjs; rm -f .v8-catalog.mjs",
  "verify:v9": "esbuild --bundle --format=esm --platform=node scripts/verify-v9-catalog.ts --outfile=.v9-catalog.mjs && node .v9-catalog.mjs; rm -f .v9-catalog.mjs",
  "audit:sheets": "esbuild --bundle --format=esm --platform=node scripts/audit-sheets.ts --outfile=.sheet-audit.mjs && node .sheet-audit.mjs; rm -f .sheet-audit.mjs",
  "import:sprites:v5": "node scripts/import-v5-sprites.mjs",
  "release:verify": "esbuild --bundle --format=esm --platform=node scripts/release-check.ts --outfile=.relcheck.mjs && node .relcheck.mjs; rm -f .relcheck.mjs",
  "build:preview": "vite build --mode preview",
  "build:release": "vite build --mode release",
  "package:web": "node scripts/package-web.mjs",
  "release": "npm run release:verify && npm run build:release && npm run package:web",
  "predev": "node scripts/git-info.mjs",
  "prebuild": "node scripts/git-info.mjs",
  "prebuild:preview": "node scripts/git-info.mjs",
  "prebuild:release": "node scripts/git-info.mjs",
  "canon:sprites": "python3 scripts/build-sprite-canon.py && npm run audit:sprite-canon && npm run verify:v9",
  "audit:sprite-canon": "python3 scripts/audit-sprite-canon.py",
  "verify:battle": "esbuild --bundle --format=esm --platform=node scripts/verify-battle.ts --outfile=.verify-battle.mjs && node .verify-battle.mjs; rm -f .verify-battle.mjs",
  "verify:hud-layout": "esbuild --bundle --format=esm --platform=node scripts/verify-hud-layout.ts --outfile=.vhud.mjs && node .vhud.mjs; rm -f .vhud.mjs",
  "verify:battle-engine": "esbuild --bundle --format=esm --platform=node scripts/verify-battle-engine.ts --outfile=.vbe.mjs && node .vbe.mjs; rm -f .vbe.mjs",
  "verify:presentation": "esbuild --bundle --format=esm --platform=node scripts/verify-presentation.ts --outfile=.vp.mjs && node .vp.mjs; rm -f .vp.mjs",
  "gen:presentation-fixtures": "esbuild --bundle --format=esm --platform=node scripts/verify-presentation.ts --outfile=.vp.mjs && node .vp.mjs --write; rm -f .vp.mjs",
  "audit:runtime": "esbuild --bundle --format=esm --platform=node scripts/audit-runtime.ts --outfile=.ar.mjs && node .ar.mjs; rm -f .ar.mjs",
  "canon:sfx": "python3 scripts/build-sfx-catalog.py",
  "verify:viewport": "esbuild --bundle --format=esm --platform=node scripts/verify-viewport.ts --outfile=.vp2.mjs && node .vp2.mjs; rm -f .vp2.mjs",
  "verify:p0-identity": "esbuild --bundle --format=esm --platform=node scripts/verify-p0-identity.ts --outfile=.vp0.mjs && node .vp0.mjs; rm -f .vp0.mjs",
  "verify:dev-studio": "esbuild --bundle --format=esm --platform=node scripts/verify-dev-studio.ts --outfile=.vds.mjs && node .vds.mjs; rm -f .vds.mjs",
  "verify:canon": "esbuild --bundle --format=esm --platform=node scripts/verify-sprite-canon.ts --outfile=.vcanon.mjs && node .vcanon.mjs; rm -f .vcanon.mjs"
 },
 "dependencies": {
  "@vitejs/plugin-react": "^4.3.4",
  "lucide-react": "^1.31.0",
  "pixi.js": "^8.19.0",
  "react": "^19.0.0",
  "react-dom": "^19.0.0",
  "typescript": "^5.7.3",
  "vite": "^6.0.7"
 },
 "devDependencies": {
  "@types/react": "^19.0.0",
  "@types/react-dom": "^19.0.0"
 }
}
