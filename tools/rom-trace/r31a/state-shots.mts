import { RomDriver } from '../nav.ts';
const [rom, sav] = process.argv.slice(2);
const d = new RomDriver(rom, sav);
await d.loadstate('r31a/jeice-offense-base.ss0');
await d.frames(5, 0);
await d.shot('r31a/ss-offense.ppm');
const r = await d.read(0xCC01, 1);
const r2 = await d.read(0xCA55, 4);
console.log(`jeice-offense: CC01=${r[0].toString(16)} CA55-58=[${r2.map(v=>v.toString(16)).join(' ')}]`);
await d.loadstate('r31a/pc_left_base.ss0');
await d.frames(5, 0);
await d.shot('r31a/ss-pcbase.ppm');
const r3 = await d.read(0xCC01, 1);
const r4 = await d.read(0xCA55, 4);
console.log(`pc_left_base: CC01=${r3[0].toString(16)} CA55-58=[${r4.map(v=>v.toString(16)).join(' ')}]`);
await d.loadstate('r31a/tail_left_base.ss0');
await d.frames(5, 0);
await d.shot('r31a/ss-tailbase.ppm');
const r5 = await d.read(0xCC01, 1);
const r6 = await d.read(0xCA55, 4);
console.log(`tail_left_base: CC01=${r5[0].toString(16)} CA55-58=[${r6.map(v=>v.toString(16)).join(' ')}]`);
await d.quit();
